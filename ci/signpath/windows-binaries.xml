<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="fooyin.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file-set>
      <include path="fooyin_*.dll" max-matches="unbounded" />
      <include path="plugins/fyplugin_*.dll" max-matches="unbounded" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
