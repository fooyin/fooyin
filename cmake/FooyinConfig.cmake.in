@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
    Qt6
    @Qt6Core_VERSION@
    NO_MODULE
    COMPONENTS
    Core
    Widgets
    Sql
    Concurrent
    Network
)

set(FOOYIN_PLUGIN_VERSION @FOOYIN_PLUGIN_VERSION@)
set(FOOYIN_PLUGIN_INSTALL_DIR "@FOOYIN_PLUGIN_INSTALL_DIR@")
set(FOOYIN_LIBRARY_INSTALL_DIR "@FOOYIN_LIBRARY_INSTALL_DIR@")

include("${CMAKE_CURRENT_LIST_DIR}/FooyinTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/FooyinMacros.cmake")
